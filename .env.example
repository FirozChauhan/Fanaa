# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: store all objects under this folder inside the bucket (e.g. textstore).
# Leave empty to use the bucket root.
R2_FOLDER=

# Passphrase used to encrypt every page with `gpg --symmetric --cipher-algo AES256`
ENC_PASSPHRASE=

# Optional session gate: a "hash key" the app asks for on every open until you
# log out from settings. Can be the plain key or its SHA-256 hex. Leave empty
# to disable the gate.
APP_HASH_KEY=

# Optional pinned label for the version shown next to the logo (e.g. v1.1.1).
# When unset the version is resolved at build time: closest git tag, then
# package.json "version". Set this only when you want to override what the
# tag/package.json would produce (e.g. an auto-generated value in CI).
NEXT_PUBLIC_APP_VERSION=
