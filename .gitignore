# Rule of thumb: a file is ignored unless it might leak a value
# out of .env. Templates (.env.example) stay, config does not.
#
# Patterns without a leading "/" match at ANY depth — a stray cache,
# database or .env inside a subfolder is just as dangerous as one at
# the root (that's how .freebuff/*.db leaked), so nothing here is
# anchored to the root unless it genuinely must be.

# ── Dependencies ─────────────────────────────────────────────────
node_modules
.pnp
.pnp.debug.mjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/
*.tgz

# ── Build output ─────────────────────────────────────────────────
.next/
out/
build/
dist/
turbo/
vite/
.esbuild/

# ── Testing ──────────────────────────────────────────────────────
coverage
.nyc_output/
.cache/nyc/
cypress/
playwright/
.cypress/
test-results/
junit.xml

# ── TypeScript ───────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Caches ───────────────────────────────────────────────────────
cache/
.eslintcache
.stylelintcache
.cache/
.cache-loader/
.parcel-cache/
.husky/_
.next/cache/

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log.*

# ── Env — EVERYTHING env-like, EXCEPT the committed template. ────
# `.env` holds R2 credentials, ENC_PASSPHRASE and APP_HASH_KEY.
# `.env*` is unanchored on purpose so nested env files are caught too.
.env*
!.env.example
*.env
.env.*.local
!.env.example.local
.envrc
.envrc.*
.npmrc

# ── Secrets — belt, braces, and suspenders. ──────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.p8
*.crt
*.csr
id_rsa
id_ecdsa
id_ed25519
*.secret
*.gpg.private
.netrc
.ssh/
.aws/
.gcloud/
kubeconfig
*.kubeconfig

# ── Databases — any SQLite/DB artifact anywhere. ──────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.db.backup
*.sql

# ── Local state / dev-tool data (the .freebuff incident class) ───
.freebuff/
.claude/
.codex/
.opencode/
.cursor/
.aider*/
.copilot/
.windsurf/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode-server/
.vscode-insiders/

# ── Vim / editor swaps & backups ─────────────────────────────────
*.swp
*.swo
.*.sw[a-p]
*~
.#*
viminfo
*.bak
*.orig
*.rej
*.tmp
*.temp

# ── OS junk ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?*
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.part

# ── Platform ─────────────────────────────────────────────────────
.vercel
.vercelignore
.netlify/
firebase-debug.log*